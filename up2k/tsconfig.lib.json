{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "../tsconfig.json"],
  "compilerOptions": {
    "types": ["vite/client"],
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "composite": true,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "./globals.d.ts"],
  "exclude": ["src/**/*.worker.ts"]
}
