{
  "compilerOptions": {
    "types": ["vite/client"],
    "target": "esnext",
    "lib": ["ESNext", "WebWorker"],
    "module": "esnext",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "composite": true,
    "skipLibCheck": true,
  },
  "include": ["src/**/*.worker.ts"]
}
